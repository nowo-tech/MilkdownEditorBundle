{
  "name": "milkdown-editor-bundle-assets",
  "version": "1.0.0",
  "description": "Browser assets for nowo-tech/milkdown-editor-bundle (private, not published to npm).",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "license": "MIT",
  "author": "Héctor Franco Aceituno <hectorfranco@nowo.tech>",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/Resources/assets/src src/Resources/assets/tests",
    "typecheck": "tsc --noEmit",
    "size": "node .scripts/bundle-size.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@milkdown/plugin-collab": "7.23.0",
    "@lezer/highlight": "1.2.5",
    "katex": "0.19.1",
    "mermaid": "12.2.0",
    "mdast-util-directive": "3.1.1",
    "micromark-extension-directive": "4.0.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "katex": "0.19.1"
    }
  }
}
