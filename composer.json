{
    "name": "nowo-tech/milkdown-editor-bundle",
    "description": "Symfony form type for Markdown editing with Milkdown and a reduced Crepe build, plus a league/commonmark renderer for the same dialect (page links, mentions, icons, directives).",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "bundle",
        "markdown",
        "milkdown",
        "crepe",
        "editor",
        "wysiwyg",
        "form",
        "commonmark",
        "nowo",
        "frankenphp"
    ],
    "homepage": "https://github.com/nowo-tech/MilkdownEditorBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Maintainer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "support": {
        "issues": "https://github.com/nowo-tech/MilkdownEditorBundle/issues",
        "source": "https://github.com/nowo-tech/MilkdownEditorBundle",
        "docs": "https://github.com/nowo-tech/MilkdownEditorBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/MilkdownEditorBundle/blob/main/docs/CHANGELOG.md"
    },
    "require": {
        "php": ">=8.2 <8.6",
        "league/commonmark": "^2.7",
        "psr/log": "^3.0",
        "symfony/asset": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/options-resolver": "^7.4 || ^8.0",
        "symfony/translation-contracts": "^3.5",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "twig/extra-bundle": "^3.21",
        "twig/string-extra": "^3.21",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "igor-php/igor-php": "^0.10",
        "nowo-tech/phpstan-frankenphp": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\MilkdownEditorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\MilkdownEditorBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "coverage-check": "phpunit --colors=always --coverage-text --coverage-clover=coverage.xml",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "twig:lint": "twig-cs-fixer lint --config=.twig-cs-fixer.php",
        "twig:fix": "twig-cs-fixer fix --config=.twig-cs-fixer.php",
        "composer-validate": "composer validate --strict",
        "qa": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "igor": "igor-php --no-agent ."
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "coverage-check": "Run PHPUnit with coverage text (CI gate)",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector refactoring",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis",
        "twig:lint": "Lint Twig templates (Twig-CS-Fixer)",
        "twig:fix": "Fix Twig templates (Twig-CS-Fixer)",
        "composer-validate": "Validate composer.json (composer validate --strict)",
        "qa": "Run all quality assurance checks",
        "igor": "Run Igor FrankenPHP worker-state audit (REQ-CS-008)"
    },
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor",
            "/.github",
            "/.specify",
            "/specs",
            "/tests",
            "/node_modules",
            "/src/Resources/assets/tests"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
