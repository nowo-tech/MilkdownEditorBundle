# Timeouts: PHP max_execution_time 30s (docker/php-dev.ini) < Caddy servers.timeouts.write 60s (below).
# FrankenPHP max_wait_time 30s caps how long a request waits for a free PHP thread.
{
	order mercure after encode
	skip_install_trust
	frankenphp {
		max_wait_time 30s
	}
	servers {
		timeouts {
			write 60s
		}
	}
}

# Worker mode: app boots once, handles requests in memory. MilkdownEditorBundle is designed for it
# (no extra config). For production, consider limiting requests per worker when possible; see
# docs/INSTALLATION.md § FrankenPHP.
:80 {
	root * /app/public
	encode zstd br gzip
	mercure {
		anonymous
	}

	php_server {
		hot_reload
		worker {
			file /app/public/index.php
			# Do not use bare `watch` (./**/*.php): Symfony dumps var/cache/**/*.php
			# and those writes restart workers mid-boot ("kernel" synthetic).
			watch /app/config/**/*.{php,yaml,yml,env}
			watch /app/src/**/*.php
			watch /app/templates/**/*.twig
			watch /app/translations/**/*.{php,yaml,yml}
			watch /var/milkdown-editor-bundle/src/**/*.{php,twig,yaml,yml,js}
		}
	}
}
