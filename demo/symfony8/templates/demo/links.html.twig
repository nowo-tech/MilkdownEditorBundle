{% extends 'base.html.twig' %}

{#
  1.18: the link picker (Ctrl+K, the link button, `[[`) with mock host endpoints, stable heading ids, and the read view
  with a "link to this section" anchor on each heading (plain fragment links: they work without JavaScript).
#}
{% block title %}{{ 'demo.links.heading'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.links.heading'|trans,
        intro: 'demo.links.lead'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.links.heading'|trans, kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'milkdown-links-form'}}) }}
                {{ form_errors(form) }}
                {% for child in form %}{% if not child.rendered and child.vars.name != 'save' %}{{ form_row(child) }}{% endif %}{% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            {% if form.save is defined %}<button type="submit" form="milkdown-links-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.save.vars.label|trans }}</button>{% endif %}
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.preview'|trans, kind: 'detail', testid: 'demo-preview', preview: preview} %}
        {% block section_body %}
            <article class="nowo-md" data-preview>{{ preview|raw }}</article>
        {% endblock %}
    {% endembed %}
{% endblock %}
