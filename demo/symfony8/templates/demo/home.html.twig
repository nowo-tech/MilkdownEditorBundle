{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.heading'|trans,
        intro: 'demo.lead'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.heading'|trans, kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'milkdown-demo-form'}}) }}
                {{ form_errors(form) }}
                {% for child in form %}{% if not child.rendered and child.vars.name != 'save' %}{{ form_row(child) }}{% endif %}{% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            {% if form.save is defined %}<button type="submit" form="milkdown-demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.save.vars.label|trans }}</button>{% endif %}
        {% endblock %}
    {% endembed %}

    {% if saved %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.preview'|trans, kind: 'detail', testid: 'demo-preview', saved: saved} %}
            {% block section_body %}
                <article class="nowo-md" data-preview>{{ saved.body|milkdown_markdown }}</article>
                {# 1.5: the read-view "Copy as Markdown" button (the demo's readers may read the whole page). #}
                {{ nowo_milkdown_copy_markdown(saved.body) }}
                {# 1.5.1: the icon-only variant (accessible name from the visually hidden label). #}
                {{ nowo_milkdown_copy_markdown(saved.body, {icon: 'only'}) }}
                <h3>{{ 'demo.markdown'|trans }}</h3>
                <pre class="nowo-ui-code-block nowo-ui-code-block--wrap" data-testid="demo-source" tabindex="0" role="region" aria-label="{{ 'demo.markdown'|trans }}">{{ saved.body }}</pre>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
