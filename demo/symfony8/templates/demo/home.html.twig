{% extends 'base.html.twig' %}

{% block body %}
    <h1>{{ 'demo.heading'|trans }}</h1>
    <p class="demo-lead">{{ 'demo.lead'|trans }}</p>

    {{ form_start(form) }}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(form) }}

    {% if saved %}
        <section class="demo-preview" aria-labelledby="preview-heading">
            <h2 id="preview-heading">{{ 'demo.preview'|trans }}</h2>
            <article class="nowo-md" data-preview>{{ saved.body|milkdown_markdown }}</article>
            {# 1.5: the read-view "Copy as Markdown" button (the demo's readers may read the whole page). #}
            {{ nowo_milkdown_copy_markdown(saved.body) }}
            {# 1.5.1: the icon-only variant (accessible name from the visually hidden label). #}
            {{ nowo_milkdown_copy_markdown(saved.body, {icon: 'only'}) }}
            <h3>{{ 'demo.markdown'|trans }}</h3>
            <pre class="demo-source">{{ saved.body }}</pre>
        </section>
    {% endif %}
{% endblock %}
