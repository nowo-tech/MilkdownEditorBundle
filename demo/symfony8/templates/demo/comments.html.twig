{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.comments.heading'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.comments.heading'|trans,
        intro: 'demo.comments.lead'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.comments.heading'|trans, kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form) }}
                {{ form_row(form.body) }}
                {% for child in form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
            {{ form_end(form) }}
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.comments.version'|trans, kind: 'detail', old: old, dark: dark} %}
        {% block section_body %}
            {{ nowo_milkdown_view(old, {label: 'demo.comments.version', features: ['toolbar', 'version_view'], theme: dark ? 'dark' : 'auto', version: {label: '2 November 2026, 10:04', copy: false}}) }}
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.comments.diff'|trans, kind: 'detail', old: old, new: new, dark: dark} %}
        {% block section_body %}
            <div{% if dark %} data-theme="dark"{% endif %} class="nowo-md">{{ nowo_milkdown_diff(old, new) }}</div>
        {% endblock %}
    {% endembed %}
{% endblock %}
