{% extends 'base.html.twig' %}

{% block title %}Host files{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Host files'}) }}
{% endblock %}

{% block body %}
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}

    {% if saved %}
        <section class="nowo-ui-card demo-preview" aria-labelledby="preview-heading">
            <div class="nowo-ui-card__body">
                <h2 id="preview-heading" class="nowo-ui-card__title">{{ 'demo.preview'|trans }}</h2>
                <article class="nowo-md" data-preview>{{ saved.body|milkdown_markdown }}</article>
                <h3>{{ 'demo.markdown'|trans }}</h3>
                <pre class="nowo-ui-code-block nowo-ui-code-block--wrap demo-source">{{ saved.body }}</pre>
            </div>
        </section>
    {% endif %}
{% endblock %}
