{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.collab.heading'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.collab.heading'|trans,
        intro: 'demo.collab.lead'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.collab.heading'|trans, kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'milkdown-collab-form'}}) }}
                {{ form_errors(form) }}
                {% for child in form %}{% if not child.rendered and child.vars.name != 'save' %}{{ form_row(child) }}{% endif %}{% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            {% if form.save is defined %}<button type="submit" form="milkdown-collab-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.save.vars.label|trans }}</button>{% endif %}
        {% endblock %}
    {% endembed %}

    {% if saved %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.markdown'|trans, kind: 'detail', testid: 'demo-preview', saved: saved} %}
            {% block section_body %}
                <pre class="nowo-ui-code-block nowo-ui-code-block--wrap" tabindex="0" role="region" aria-label="{{ 'demo.markdown'|trans }}" data-testid="saved">{{ saved.body }}</pre>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
