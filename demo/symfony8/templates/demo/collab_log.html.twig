{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.collab.heading'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.collab.heading'|trans}) }}
{% endblock %}

{% block body %}
    {% if status == 302 %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.collab.heading'|trans, kind: 'detail'} %}
            {% block section_body %}<p data-testid="save-result">saved</p>{% endblock %}
        {% endembed %}
    {% else %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.collab.heading'|trans, kind: 'form', form: form} %}
            {% block section_body %}
                {{ form_start(form, {attr: {id: 'milkdown-collab-log-form'}}) }}
                    {{ form_errors(form) }}
                    {% for child in form %}{% if not child.rendered and child.vars.name != 'save' %}{{ form_row(child) }}{% endif %}{% endfor %}
                {{ form_end(form, {render_rest: false}) }}
            {% endblock %}
            {% block section_footer %}
                {% if form.save is defined %}<button type="submit" form="milkdown-collab-log-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.save.vars.label|trans }}</button>{% endif %}
            {% endblock %}
        {% endembed %}
        {% if status == 409 %}
            {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.collab.heading'|trans, kind: 'detail'} %}
                {% block section_body %}<p data-testid="save-result">conflict</p>{% endblock %}
            {% endembed %}
        {% endif %}
    {% endif %}
{% endblock %}
