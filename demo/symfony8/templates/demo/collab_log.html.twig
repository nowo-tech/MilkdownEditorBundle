{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.collab.heading'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'demo.collab.heading'|trans }}</h1>
    {% if status == 302 %}
        <p data-testid="save-result">saved</p>
    {% else %}
        {{ form_start(form) }}
            {{ form_rest(form) }}
        {{ form_end(form) }}
        {% if status == 409 %}<p data-testid="save-result">conflict</p>{% endif %}
    {% endif %}
{% endblock %}
