{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). The editor assets are the bundle's own. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _dark = dark|default(false) %}
{% set nowo_ui_demo_platform = {
    bundle: 'Milkdown Editor',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/MilkdownEditorBundle',
    translation_domain: 'messages',
    locales: [],
    nav: [
        {label: 'demo.light', route: 'demo_home', active: _dark ? [] : ['demo_home'], section: 'demo.nav', testid: 'demo-nav-demo_home_light'},
        {label: 'demo.dark', route: 'demo_home', params: {theme: 'dark'}, active: _dark ? ['demo_home'] : [], section: 'demo.nav', testid: 'demo-nav-demo_home_dark'},
        {label: 'demo.comments.nav', route: 'demo_comments', section: 'demo.nav', testid: 'demo-nav-demo_comments'},
        {label: 'demo.layers.nav', route: 'demo_layers', section: 'demo.nav', testid: 'demo-nav-demo_layers'},
        {label: 'demo.links.nav', route: 'demo_links', section: 'demo.nav', testid: 'demo-nav-demo_links'},
        {label: 'demo.collab.nav', route: 'demo_collab', section: 'demo.nav', testid: 'demo-nav-demo_collab'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Milkdown Editor Bundle demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_head %}
    {#- `?theme=dark`: the page follows the editor's dark theme. UiKit's theme boot (before this block) resolved the
        theme from storage or the OS; the demo's Dark view forces it, as a host would with data-nowo-ui-pref-theme. -#}
    {% if dark|default(false) %}
        <script nonce="{{ app.request.attributes.get('csp_nonce') }}">document.documentElement.setAttribute('data-nowo-ui-pref-theme', 'dark');document.documentElement.setAttribute('data-theme', 'dark');</script>
    {% endif %}
    {{ nowo_milkdown_editor_assets() }}
{% endblock %}

