{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The editor assets are the bundle's own; demo.css only styles the layers
    fixture page (sticky header / transformed ancestor), with UiKit tokens. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Milkdown Editor Bundle demo{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {{ nowo_milkdown_editor_assets() }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('demo.css') }}">
{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Milkdown Editor Bundle</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.nav'|trans }}">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}"{% if _route == 'demo_home' and not dark|default(false) %} aria-current="page"{% endif %}>{{ 'demo.light'|trans }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_home', {theme: 'dark'}) }}"{% if _route == 'demo_home' and dark|default(false) %} aria-current="page"{% endif %}>{{ 'demo.dark'|trans }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_comments') }}"{% if _route == 'demo_comments' %} aria-current="page"{% endif %}>{{ 'demo.comments.nav'|trans }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_layers') }}"{% if _route == 'demo_layers' %} aria-current="page"{% endif %}>{{ 'demo.layers.nav'|trans }}</a>
            <a class="nowo-ui-link" href="{{ path('demo_collab') }}"{% if _route == 'demo_collab' %} aria-current="page"{% endif %}>{{ 'demo.collab.nav'|trans }}</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
